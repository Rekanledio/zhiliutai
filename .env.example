# Copy to .env for local use. Never commit .env or real credentials.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Local persistence. Relative paths resolve from the repository root.
DATABASE_URL=sqlite+aiosqlite:///data/zhiliutai.db
QDRANT_PATH=data/qdrant
SQLITE_BUSY_TIMEOUT_MS=5000
WORKFLOW_CHECKPOINT_PATH=data/checkpoints/workflows.db
# Server-generated offline backup archives; clients cannot choose this path.
BACKUP_ROOT=data/backups

# Local data boundaries. Use an absolute path for a real Vault and keep it out of Git.
VAULT_PATH=
MANAGED_VAULT_DIR=知流台
# Relative paths resolve from the repository root, not the process cwd.
ARTIFACT_ROOT=data/artifacts
OBSIDIAN_WATCH_INTERVAL_SECONDS=1.0

# Chat and Embedding are independent capabilities.
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_CACHE_PATH=data/models/fastembed
# Only used when EMBEDDING_PROVIDER=openai-compatible.
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
ASR_BASE_URL=http://127.0.0.1:11434/v1
ASR_MODEL=
ASR_API_KEY=
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_MODEL=
VISION_API_KEY=
RERANKER_BASE_URL=http://127.0.0.1:8001
RERANKER_MODEL=
RERANKER_API_KEY=
