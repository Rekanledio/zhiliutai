# Copy to .env for local use. Never commit .env or real credentials.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Local persistence. Relative paths resolve from the repository root.
DATABASE_URL=sqlite+aiosqlite:///data/zhiliutai.db
QDRANT_PATH=data/qdrant
SQLITE_BUSY_TIMEOUT_MS=5000
WORKFLOW_CHECKPOINT_PATH=data/checkpoints/workflows.db
# Server-generated offline backup archives; clients cannot choose this path.
BACKUP_ROOT=data/backups

# Local data boundaries. Use an absolute path for a real Vault and keep it out of Git.
VAULT_PATH=
MANAGED_VAULT_DIR=知流台
# Relative paths resolve from the repository root, not the process cwd.
ARTIFACT_ROOT=data/artifacts
OBSIDIAN_WATCH_INTERVAL_SECONDS=1.0

# Chat and Embedding are independent capabilities.
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_CACHE_PATH=data/models/fastembed
# Only used when EMBEDDING_PROVIDER=openai-compatible.
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
ASR_PROVIDER=faster-whisper
ASR_BASE_URL=
ASR_MODEL=medium
ASR_API_KEY=
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8_float16
ASR_CPU_COMPUTE_TYPE=int8
ASR_LOCAL_FILES_ONLY=true
ASR_CACHE_PATH=data/models/faster-whisper
VISION_PROVIDER=openai-compatible
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_API_KEY=
VISION_REQUEST_TIMEOUT_SECONDS=60
VISION_MAX_IMAGE_BYTES=10000000
RERANKER_PROVIDER=sentence-transformers
RERANKER_BASE_URL=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_DEVICE=cpu
RERANKER_LOCAL_FILES_ONLY=true
RERANKER_CACHE_PATH=data/models/reranker

# Video capability: use a command name on PATH or a local executable path in .env.
VIDEO_FFMPEG_EXECUTABLE=ffmpeg
VIDEO_VISION_KEYFRAME_INTERVAL_SECONDS=30
VIDEO_VISION_MAX_KEYFRAMES=24
